# Greenbacks ERP - Environment Configuration Template
# Production secrets must NEVER be committed to version control.

# Application Settings
DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-cryptographically-secure-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1,erp.yourdomain.com

# Database (PostgreSQL for production, SQLite fallback in development)
DATABASE_URL=postgres://erp_user:secure_password@localhost:5432/greenbacks_erp_db
DB_NAME=greenbacks_erp_db
DB_USER=erp_user
DB_PASSWORD=secure_password
DB_HOST=localhost
DB_PORT=5432

# Redis & Celery
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# JWT Auth
JWT_SECRET_KEY=replace-with-jwt-encryption-key
JWT_ACCESS_TOKEN_LIFETIME_HOURS=24
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# CORS & Frontend Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://erp.yourdomain.com

# Email / SMTP (Optional External Service)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-api-key
DEFAULT_FROM_EMAIL=notifications@greenbacks.corp

# Storage & Media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
