{
  "name": "odias-erp-root",
  "version": "2.0.0",
  "private": true,
  "description": "Odias ERP Root Workspace Runner",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:all": "node scripts/dev.js",
    "frontend": "npm --prefix frontend run dev",
    "backend": "python backend/manage.py runserver 127.0.0.1:8000",
    "build": "npm --prefix frontend run build",
    "seed": "python backend/manage.py seed_data",
    "test:backend": "python backend/manage.py test"
  }
}
